APP_NAME=GeminiSecure
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Gemini's own clock (M19A §9): the platform's calendar, invoices and pay periods, and the fallback
# for an estate row with no readable zone. Every estate keeps its own, chosen when it is provisioned.
PLATFORM_TIMEZONE=America/Jamaica

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0+ or MariaDB 10.11+ required. Confirm with SELECT VERSION().
# Older MariaDB lacks enforced CHECK constraints and breaks the accounting module.
#
# Tenant isolation is PHYSICAL, not row-level: each estate has its own
# gs_estate_<subdomain> database, created and granted individually by
# stancl/tenancy at provisioning time. A leak between two communities is
# therefore a connection error, not a query error.
#
# Laravel connects as gs_app: not the schema owner, not root. gs_app must never
# hold a wildcard grant such as gs_estate_%.* -- that would defeat the model.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gs_platform
DB_USERNAME=gs_app
DB_PASSWORD=

# Schema owner. Migrations and grant DDL only, never request-serving:
#   php artisan migrate --database=mysql_owner
DB_OWNER_USERNAME=gs_owner
DB_OWNER_PASSWORD=

TENANCY_DATABASE_PREFIX=gs_estate_

# Estate consoles are served from a subdomain of this host, one per estate.
ESTATE_DOMAIN=geminisecure.com

SESSION_DRIVER=database

# Sessions are IDENTITY, and identity is central. Without this the tenancy
# bootstrapper swaps the default connection and an estate request looks for
# the sessions table inside gs_estate_<subdomain>, where it does not exist.
SESSION_CONNECTION=mysql
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outbound mail (13 B7). Invitations, password resets, invoice sends and
# notices all leave through this. A real SMTP relay in every environment that
# has people in it: production refuses to boot on `log` or `array`, because a
# mailer that writes to a file sends nothing and says nothing.
# For local development only, MAIL_MAILER=log is fine.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.replace-with-your-provider.example
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_ADDRESS="no-reply@replace-with-your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# TEXT MESSAGES. Two things use this: Resident App sign-in codes, and the four
# numbers a panic at a site is texted (Q-M09 — President, Property Office, PPV1
# Head of Security, Gemini Dispatch).
#
# NO PROVIDER IS BOUGHT YET. Empty or `log` means every message is WRITTEN DOWN
# and delivered to nobody; the panic path still runs end to end and records the
# outcome as `recorded`, never as sent. Sign-in codes fall back to email, and the
# app says so.
#
# To switch it on (M10 §1): buy a Twilio account that can originate to Jamaican
# mobiles (+1 876 / +1 658), then enter it in the Gemini Console under Platform
# settings → SMS and send a test. That needs no deploy and nothing in this file:
# what is saved there overrides these four, and the token is encrypted at rest.
# These are only the fallback for a server where nothing has been saved.
SMS_DRIVER=
SMS_ACCOUNT_SID=
SMS_TOKEN=
SMS_FROM=

# RESIDENT APP ACCESS LEVELS (Member, Dependent, Helper). Leave this OFF until the
# Resident App release that reads `panic.contacts` is in the stores AND the estate
# console's claim approval carries the office's level choice. The app in the field
# takes the panic screen's "text / call my emergency contacts" people only from the
# household screen, which a Helper may not read, so a Helper made too early would
# find that sheet empty. Off, nobody can be given less than Member access; the
# server still checks every request against the level each person has.
RESIDENT_APP_ACCESS_LEVELS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb, read by resources/js/echo.js at build time.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The event simulator at /simulator. Off unless set; when off the route does not exist.
GS_SIMULATOR_ENABLED=false

# The public pages both app stores load themselves: /legal/privacy, /legal/terms,
# /support, /account/delete and /apps (config/legal.php, routes/public.php).
#
# The company's real contact details are the DEFAULTS in config/legal.php, so a fresh
# deployment already serves them and no page can go out blank. These keys exist only to
# move a value without a release. Leave them unset unless something has actually changed.
#
# LEGAL_COMPANY_NAME="Gemini Security"                # the registered legal name, once the company gives it
# LEGAL_COMPANY_ADDRESS="Shop #20P, Portmore Town Centre, Portmore, Saint Catherine, Jamaica, West Indies"
# LEGAL_SUPPORT_EMAIL=gemisecja@gmail.com
# LEGAL_SUPPORT_PHONE=                                # there is none; the pages leave the line out
#
# The ONE switch that takes the DRAFT banner off the privacy policy and the terms, and
# the one `gate:store --release` refuses a submission without. Set it to `final` only
# when the company's attorney has signed the text off (LEGAL_REVIEW_PACK.md in the
# mobile repository is what goes to them).
# LEGAL_TEXT_STATUS=final
