# Copy to .env.development. Only EXPO_PUBLIC_ variables reach the app, and they are
# visible inside the bundle — never put a secret here.
#
# NEVER localhost: on a phone that means the phone. Use the laptop's LAN address.
EXPO_PUBLIC_API_URL=http://192.168.18.119:8000/api/v1
EXPO_PUBLIC_APP_ENV=development

# The EAS project an Expo PUSH token is issued under (M4 §3.2). A development build needs it
# before the server can reach this handset with the app closed; without it the app asks for no
# token and says so. `eas project:info` prints the id. Not needed in Expo Go — there is no push
# there at all — and not a secret.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# The clock a phone reads before the server has named the estate's zone — this installation's
# (Gemini's), as the server's PLATFORM_TIMEZONE is. An IANA name. Unset, it is UTC (M19A §9: the
# code names no zone). Every estate's own zone replaces it on the first answer.
EXPO_PUBLIC_PLATFORM_TIMEZONE=America/Jamaica

# GUARD APP ONLY. Set to `off` to stop asking the officer for Do Not Disturb access
# (ACCESS_NOTIFICATION_POLICY) — the row on More → Notifications disappears and nothing sends
# anybody to the phone's Do Not Disturb settings. Default (unset) is ON: M6 §2.2, D-M119. This is
# the reversible half only; the safety channel keeps the bypass flag it was built with, Android
# drops it in silence without the permission, and the app then reports `off` because that is the
# truth. A JS change — it ships over the air, with no new binary.
# EXPO_PUBLIC_ASK_DND_ACCESS=off
