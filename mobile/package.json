{
  "name": "geminisecure-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "GeminiSecure Guard App and Resident App — Expo SDK 57 monorepo",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node tools/patches/apply.mjs",
    "gate:patches": "node tools/patches/apply.mjs --check",
    "design:manifest": "powershell -ExecutionPolicy Bypass -File tools/design-manifest.ps1",
    "design:check": "powershell -ExecutionPolicy Bypass -File tools/design-manifest.ps1 -Check",
    "design:regions": "node tools/fidelity/build-regions.mjs",
    "tokens": "node tools/tokens/extract.mjs",
    "tokens:check": "node tools/tokens/extract.mjs --check",
    "fidelity": "node tools/fidelity/compare.mjs",
    "fidelity:selftest": "node tools/fidelity/selftest.mjs",
    "fidelity:report": "node tools/fidelity/report.mjs",
    "lift": "node tools/lift/lift.mjs",
    "design:values": "node tools/design/resident-values.mjs",
    "design:values:check": "node tools/design/resident-values.mjs --check",
    "design:walk": "node tools/design/design-walk.mjs",
    "design:tokens:resident": "node tools/design/resident-tokens.mjs",
    "design:tokens:resident:check": "node tools/design/resident-tokens.mjs --check",
    "design:app-walk": "node tools/design/app-walk.mjs",
    "design:gallery-proof": "node tools/design/gallery-proof.mjs",
    "gate:resident-literals": "node tools/gates/resident-design-literals.mjs",
    "gate:resident-literals:selftest": "node tools/gates/resident-design-literals.mjs --selftest",
    "gate:resident-dark-inks": "node tools/gates/resident-dark-inks.mjs",
    "gate:resident-dark-inks:selftest": "node tools/gates/resident-dark-inks.mjs --selftest",
    "design:contrast": "node tools/design/design-contrast.mjs",
    "api:pull": "powershell -ExecutionPolicy Bypass -File tools/api/pull-catalogue.ps1",
    "api:generate": "node tools/api/generate.mjs",
    "gate:selftest": "node tools/gates/selftest.mjs",
    "flow": "node tools/fidelity/flow-check.mjs",
    "gate:tokens": "node tools/gates/no-hex-literals.mjs",
    "gate:pressable": "node tools/gates/no-rn-pressable.mjs",
    "gate:native-style": "node tools/gates/native-style-safety.mjs",
    "gate:guard-no-money": "node tools/gates/guard-no-money.mjs",
    "gate:dead-controls": "node tools/gates/no-dead-controls.mjs",
    "gate:append-only": "node tools/gates/append-only.mjs",
    "gate:camera-frames": "node tools/gates/camera-frames.mjs",
    "gate:a11y": "node tools/gates/a11y-labels.mjs",
    "gate:routes": "node tools/gates/routes-exist.mjs",
    "audit:contrast": "node tools/gates/contrast.mjs",
    "gate:contrast": "node tools/gates/contrast.mjs --strict",
    "gate:expo-go": "node tools/gates/expo-go-safety.mjs",
    "gate:api-url": "node tools/gates/one-api-url.mjs",
    "gate:one-clock": "node tools/gates/one-clock.mjs",
    "gate:location": "node tools/gates/location-discipline.mjs",
    "gate:shuffled-order": "node tools/gates/shuffled-order.mjs",
    "gate:contact": "node tools/gates/contact-details.mjs",
    "gate:store": "node tools/gates/store.mjs",
    "gate:ring-native": "node tools/gates/guard-ring-native.mjs",
    "gate:no-keystore": "node tools/gates/no-keystore.mjs",
    "signing:verify-apk": "node tools/signing/verify-apk.mjs",
    "signing:fingerprints": "node tools/signing/check-fingerprints.mjs",
    "test:ring-native": "node tools/ring/test-native.mjs",
    "gate:store:release": "node tools/gates/store.mjs --release",
    "store:assets": "node tools/store/brand-assets.mjs && node tools/store/screenshots.mjs",
    "store:icons": "node tools/store/brand-assets.mjs",
    "store:screenshots": "node tools/store/screenshots.mjs",
    "device:check": "node tools/device/harness.mjs",
    "device:plan": "node tools/device/plan.mjs",
    "device:checks": "node tools/device/run-checks.mjs",
    "device:fidelity": "node tools/device/fidelity.mjs",
    "device:selftest": "node tools/device/selftest.mjs",
    "gates": "npm run design:check && npm run tokens:check && npm run design:values:check && npm run design:tokens:resident:check && npm run gate:resident-literals && npm run gate:resident-literals:selftest && npm run gate:resident-dark-inks && npm run gate:resident-dark-inks:selftest && npm run gate:tokens && npm run gate:pressable && npm run gate:native-style && npm run gate:guard-no-money && npm run gate:dead-controls && npm run gate:append-only && npm run gate:camera-frames && npm run gate:a11y && npm run gate:routes && npm run gate:contrast && npm run gate:expo-go && npm run gate:api-url && npm run gate:one-clock && npm run gate:location && npm run gate:shuffled-order && npm run gate:contact && npm run gate:store && npm run gate:ring-native && npm run gate:no-keystore && npm run gate:patches && npm run gate:selftest && npm run fidelity:selftest && npm run device:selftest",
    "test": "npm test --workspace @gs/core && npm test --workspace @gs/guard && npm test --workspace @gs/resident",
    "test:tz": "node tools/tests/tz.mjs",
    "test:api": "node --test \"tools/api/__tests__/*.test.mjs\"",
    "test:signing": "node --test \"tools/signing/__tests__/*.test.mjs\"",
    "verify": "npm run typecheck && npm test && npm run test:tz && npm run test:api && npm run test:signing && npm run gates",
    "flow:enrol": "node tools/flows/guard-enrol.mjs",
    "typecheck": "npm run typecheck --workspace @gs/core && npm run typecheck --workspace @gs/guard && npm run typecheck --workspace @gs/resident",
    "guard": "npm start --workspace @gs/guard",
    "resident": "npm start --workspace @gs/resident"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "pixelmatch": "^7.2.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19"
  }
}
