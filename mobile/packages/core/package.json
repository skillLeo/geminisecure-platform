    "./theme": "./theme/index.ts",
    "./theme/tokens.json": "./theme/tokens.json",
    "./theme/board-only.json": "./theme/board-only.json",
    "./theme/tailwind": "./theme/tailwind.cjs",
    "./ui": "./ui/index.ts",
    "./offline": "./offline/index.ts",
    "./live": "./live/index.ts",
    "./crypto": "./crypto/index.ts",
    "./crypto/deviceUid": "./crypto/deviceUid.ts",
    "./lib": "./lib/index.ts",
    "./safety": "./safety/index.ts",
    "./notify": "./notify/index.ts",
