# dependencies
node_modules/
.pnp
.pnp.js

# expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
# the release key's password (M33 §2): it lives with the key, outside every repository; never here
signing.properties
keystore.properties
*.mobileprovision
*.orig.*

# native build output (managed workflow — regenerated by prebuild)
apps/*/ios/
apps/*/android/
# a local native module's Gradle output (its android/ source is tracked, its build/ is not)
apps/*/modules/*/android/build/
apps/*/modules/*/android/.gradle/

# metro / caches
.metro-health-check*
*.tsbuildinfo

# env — values live in EAS environment variables; .env.example is committed
.env
.env.*
!.env.example

# fidelity harness output (the expected/ crops are regenerated by design:regions)
_design/screenshots/diff/
_design/screenshots/actual/
# M42 side-by-sides and overlays (tools/design/app-walk.mjs): regenerated on every run; the numbers are committed
# in _design/RESIDENT_CHECKS.json, the images stay on the machine like the device captures below.
_design/screenshots/compare/

# device harness output — captures off a real handset. The NUMBERS are committed
# (_design/FIDELITY_DEVICE.json, _design/PHONE_CHECK_RESULTS.json, _design/DEVICE.json);
# the images are evidence for the run that produced them and stay on the machine.
_design/screenshots/device/
_design/screenshots/diff-device/
_design/screenshots/checks/

# maestro
.maestro/screenshots/

# os / editor
.DS_Store
Thumbs.db
*.log
npm-debug.*
yarn-error.*
.vscode/*
!.vscode/extensions.json

# Local tooling downloaded on demand (adb platform-tools) - never committed
.tools/

# Build scaffolding, not a deliverable: the scratch tooling used while building, and one-off
# audit output. The operational documents are NOT ignored - they are the operating manual and
# they are version-controlled with the code, because a document that exists on one laptop is
# a document that is one failed disk away from gone.
_audit/

# Editor and assistant scratch directories
.cursor/
.aider*
.idea/

# Release APKs, staged here for handover. 48 MB each; the build is reproducible from source.
/build/
